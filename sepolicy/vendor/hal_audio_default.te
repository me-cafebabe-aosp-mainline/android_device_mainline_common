get_prop(hal_audio_default, vendor_audio_prop)
r_dir_file(hal_audio_default, vendor_sysfs_dmi_id)

allow hal_audio_default vendor_sysfs_sound:file rw_file_perms;

# vendor.mainline.audio.IControl/default of the mainline audio HAL.
add_service(hal_audio_default, hal_mainline_audio_control_service)

# State kept for its settings app (mixer values, ...).
allow hal_audio_default mainline_audio_data_file:dir rw_dir_perms;
allow hal_audio_default mainline_audio_data_file:file create_file_perms;
