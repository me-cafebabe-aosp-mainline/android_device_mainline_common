# Block
allow vendor_init sysfs_devices_block:file rw_file_perms;

# DHCP
set_prop(vendor_init, vendor_recovery_ethernet_dhcp_prop)

# Misc
allow vendor_init rootfs:dir read;

# Properties
set_prop(vendor_init, vendor_audio_prop)
set_prop(vendor_init, vendor_camera_prop)
set_prop(vendor_init, vendor_gralloc_prop)
set_prop(vendor_init, vendor_hwc_drm_prop)
set_prop(vendor_init, vendor_light_prop)
set_prop(vendor_init, vendor_mesa_prop)
set_prop(vendor_init, vendor_sensors_iio_prop)
set_prop(vendor_init, vendor_tablet2multitouch_prop)
set_prop(vendor_init, vendor_usb_prop)
set_prop(vendor_init, vendor_wifi_mac_prefix)
