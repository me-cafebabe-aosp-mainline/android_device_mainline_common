# Block devices
/dev/block/sd[a-z][0-9]*	u:object_r:sd_device:s0
/dev/block/zram0		u:object_r:swap_block_device:s0

# Camera
/dev/media[0-9]+	u:object_r:video_device:s0
/dev/v4l-subdev[0-9]+	u:object_r:video_device:s0

# Executables
/(vendor|system/vendor)/bin/hw/android\.hardware\.audio\.effect\.service-aidl\.legacy			u:object_r:hal_audio_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.composer\.hwc3-service\.drm(_upstream)?		u:object_r:hal_graphics_composer_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.media\.c2-service-v4l2				u:object_r:mediacodec_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.media\.c2@1\.2-service-v4l2-(32|64)			u:object_r:mediacodec_exec:s0
/(vendor|system/vendor)/bin/hw/bdaddr									u:object_r:set_bdaddr_exec:s0
/(vendor|system/vendor)/bin/dlkm_loader(_mainline)?							u:object_r:dlkm_loader_exec:s0
/(vendor|system/vendor)/bin/set_bdaddr\.sh								u:object_r:set_bdaddr_exec:s0
/(vendor|system/vendor)/bin/setup_wifi									u:object_r:setup_wifi_exec:s0
/(vendor|system/vendor)/bin/suspend_blocker								u:object_r:suspend_blocker_exec:s0
/(vendor|system/vendor)/bin/tablet2multitouch								u:object_r:tablet2multitouch_exec:s0
/(vendor|system/vendor)/bin/ts_vkeys									u:object_r:vendor_ts_vkeys_exec:s0

# Firmware
/(vendor|system/vendor)/firmware(/.*)?		u:object_r:vendor_firmware_file:s0

# Graphics
/dev/dri		u:object_r:gpu_device:s0
/dev/dri/card[0-9]+	u:object_r:gpu_device:s0
/dev/dri/renderD[0-9]+	u:object_r:gpu_device:s0

# HDMI CEC
/dev/cec[0-9]+		u:object_r:cec_device:s0

# LEDs
/sys/devices/.*/leds/[^/]*:(flash|torch)[^/]*(/.*)?	u:object_r:vendor_sysfs_camera_flash:s0

# Rfkill
/dev/rfkill		u:object_r:rfkill_device:s0

# Same-Process HAL
/(vendor|system/vendor)/lib(64)?/hw/gralloc\.gbm\.so						u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/hw/mapper\.minigbm_[a-z]+\.so					u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/hw/vulkan\.[a-z_]+\.so						u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/android\.hardware\.graphics\.allocator@[2-4]\.0\.so		u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/dri_gbm\.so							u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libaconfig_storage_read_api_cc\.so				u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libdrm(_upstream)?\.so						u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libgallium_dri\.so						u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libgbm_mesa\.so						u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libLLVM[0-9]+\.so						u:object_r:same_process_hal_file:s0
/(vendor|system/vendor)/lib(64)?/libui\.so							u:object_r:same_process_hal_file:s0
