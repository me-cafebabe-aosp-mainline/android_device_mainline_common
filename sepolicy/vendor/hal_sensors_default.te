# IIO
allow hal_sensors_default iio_device:chr_file r_file_perms;
allow hal_sensors_default vendor_sysfs_iio:file rw_file_perms;
get_prop(hal_sensors_default, vendor_sensors_iio_prop)
r_dir_file(hal_sensors_default vendor_sysfs_iio)

# vendor.mainline.sensors.IVirtualSensors/default of the mainline sensors HAL's
# virtual backend.
add_service(hal_sensors_default, hal_mainline_sensors_virtual_service)

# Values the virtual backend keeps for its settings app.
allow hal_sensors_default mainline_sensors_data_file:dir rw_dir_perms;
allow hal_sensors_default mainline_sensors_data_file:file create_file_perms;
